# Mac(oMLX) 部署样例: 复制为 asr.env, chmod 600
# 数据/模型目录指向本机
ASR_DATA_DIR=~/asr-mac/data
ASR_MODEL_DIR=~/asr-mac/models

# 访问令牌(不设则启动时自动生成到 data/.auth-token)
ASR_WEB_TOKEN=

# ASR 后端: oMLX 的 /v1/audio/transcriptions(免装 FunASR)
ASR_PROVIDER=omlx
OMLX_BASE_URL=http://127.0.0.1:18000
OMLX_API_KEY=粘贴你的oMLX密钥
OMLX_ASR_MODEL=mlx-community__whisper-large-v3-turbo

# LLM: oMLX 的 chat 接口(建议 27B-8bit; 大模型与它互挤内存)
LLM_BASE_URL=http://127.0.0.1:18000/v1
LLM_API_KEY=粘贴你的oMLX密钥
LLM_MODEL=Qwen3.8-27B-8bit

# Mac 本机跑, 上传放宽一点也行(默认 512MB/120 分钟)
ASR_MAX_UPLOAD_MB=512
ASR_MAX_DURATION_MIN=120
